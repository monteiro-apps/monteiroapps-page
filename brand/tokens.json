{
  "name": "Monteiro Apps",
  "version": "1.1",
  "color": {
    "roxo-monteiro": { "value": "#5532E0", "role": "Principal — logo, botões, links, destaques" },
    "roxo-profundo": { "value": "#2A1670", "role": "Apoio — estados pressionados, fundos de impacto" },
    "lavanda":       { "value": "#EDE9FE", "role": "Apoio — fundos suaves, tags, seleção" },
    "lilas":         { "value": "#B9A8FF", "role": "Apoio — botões secundários, texto de destaque sobre grafite" },
    "coral":         { "value": "#FF6F61", "role": "Destaque — selos, avisos, ponto do símbolo; texto sobre ele em grafite" },
    "grafite":       { "value": "#17151F", "role": "Texto principal e fundos escuros" },
    "cinza-ardosia": { "value": "#6B6878", "role": "Texto secundário" },
    "texto-corpo":   { "value": "#4A4757", "role": "Parágrafos sobre fundo claro" },
    "nevoa":         { "value": "#F6F5FA", "role": "Fundo de telas" },
    "borda":         { "value": "#E7E4F0", "role": "Bordas e divisores" },
    "branco":        { "value": "#FFFFFF", "role": "Cards e superfícies" }
  },
  "proportion": { "claros": "60%", "grafite": "25%", "roxo": "10%", "coral": "5%" },
  "font": {
    "display": { "family": "Sora", "weights": [400, 600, 700], "use": "Logotipo, títulos, números" },
    "body":    { "family": "DM Sans", "weights": [400, 500, 700], "use": "Textos, botões, interface" }
  },
  "type-scale": {
    "h1":      { "font": "Sora", "size": "40–68px", "weight": 700, "letterSpacing": "-0.04em" },
    "h2":      { "font": "Sora", "size": "30–44px", "weight": 700, "letterSpacing": "-0.03em" },
    "h3":      { "font": "Sora", "size": "20–24px", "weight": 600, "letterSpacing": "-0.02em" },
    "body":    { "font": "DM Sans", "size": "16px", "weight": 400, "lineHeight": 1.5 },
    "caption": { "font": "DM Sans", "size": "13px", "weight": 500, "letterSpacing": "0.14em", "transform": "uppercase" }
  },
  "radius": { "sm": "12px", "md": "18px", "lg": "24px", "xl": "32px", "pill": "999px", "icon": "32/120 do lado" },
  "spacing": { "base": "8px", "section": "96px", "container": "1200px", "gutter": "24px" }
}
